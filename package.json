{
  "name": "presentation-maker",
  "version": "0.0.0",
  "private": true,
  "description": "AI-сервис генерации презентаций по брендовому шаблону",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter @pm/shared --filter @pm/ml build",
    "dev": "pnpm build:libs && pnpm --parallel --filter @pm/shared --filter @pm/ml --filter @pm/api --filter @pm/web dev",
    "typecheck": "pnpm build:libs && pnpm -r typecheck",
    "format": "prettier --write .",
    "cli": "node apps/cli/bin/dev.js",
    "infra:up": "docker compose -f infra/dev/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/dev/docker-compose.yml down",
    "db:migrate": "pnpm --filter @pm/api db:migrate",
    "db:studio": "pnpm --filter @pm/api db:studio",
    "test": "pnpm -r --if-present test",
    "infra:up:memory": "docker compose -f infra/dev/docker-compose.yml -f infra/dev/docker-compose.tmpfs.yml up -d --wait"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
