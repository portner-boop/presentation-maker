# all — http + воркеры в одном процессе (dev); api / worker — раздельно (prod)
APP_ROLE=all
PORT=3000

DATABASE_URL=postgresql://pm:pm@localhost:5433/presentation_maker
REDIS_URL=redis://localhost:6380

# куда складываются загруженные шаблоны и результаты
STORAGE_DIR=./storage

TEMPLATE_ANALYSIS_CONCURRENCY=1
# 3 презентации генерируются параллельно и должны уложиться в 5 минут
GENERATION_CONCURRENCY=3
CACHE_TTL_MS=3600000

# OpenAI-совместимый LLM API (облако, vLLM, LM Studio…)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# одновременных запросов на процесс: 3 генерации × ~12 слайдов
LLM_MAX_CONCURRENCY=12
# json_schema | json_object | prompt — клиент сам понизит режим, если сервер не умеет
LLM_STRUCTURED_OUTPUT=json_schema

# превью слайдов: LibreOffice (soffice) + poppler (pdftoppm)
PREVIEW_ENABLED=true
SOFFICE_PATH=
PDFTOPPM_PATH=
