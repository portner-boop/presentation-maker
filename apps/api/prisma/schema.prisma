generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TemplateStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum PresentationStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

/// Брендовый шаблон или контент-пакет. После анализа в profile лежат токены, шрифты, лейауты, тон.
model Template {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  fileName      String
  fileKey       String
  status        TemplateStatus @default(PENDING)
  profile       Json?
  previewCount  Int?
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  presentations Presentation[]
}

/// Сгенерированная презентация: слайды вместе с текстом спикера.
model Presentation {
  id              String             @id @default(uuid()) @db.Uuid
  templateId      String             @db.Uuid
  template        Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title           String?
  brief           String
  durationMinutes Int?
  gitUrl          String?
  status          PresentationStatus @default(PENDING)
  progress        Json?
  slides          Json?
  stats           Json?
  sourcesKey      String?
  fileKey         String?
  scriptKey       String?
  previewCount    Int?
  error           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([templateId])
}
